mixin datepicker({identifier, typeCalendar="static", titleStart="", titleEnd="", dateEndText="ДД.ММ.ГГГГ", title= "Заголовок", initialText= "Начальный текст"})
  .datepicker(class= `datepicker_type_${typeCalendar}`)
    input.date-calendar.js-date-calendar(class= identifier, data-typeCalendar= typeCalendar, data-identifier= identifier)    

    if(typeCalendar === "dropdown")
      label.datepicker__dropdown-title(for="dateDropdownBtnStart")= titleStart
      label.datepicker__dropdown-title(for="dateDropdownBtnEnd")= titleEnd
      button.datepicker__dropdown-btn(id="dateDropdownBtnStart" data-value="start" data-identifier= identifier)
        span.datepicker__dropdown-text ДД.ММ.ГГГГ
        +chevron({})
      button.datepicker__dropdown-btn(id="dateDropdownBtnEnd" data-value="end" data-identifier= identifier)
        span.datepicker__dropdown-text= dateEndText
        +chevron({})

    if(typeCalendar === "filter")
      label.datepicker__filter-title(for=identifier)= title
      .datepicker__filter-wrap
        input.datepicker__filter-input(id=identifier value= initialText disabled data-identifier= identifier)
        button.datepicker__filter-btn(data-identifier= identifier)
          +chevron({})

