include ../button/button
include ../chevron/chevron

mixin dropdown({title="Заголовок", buttonText="Текст кнопки", isOpen=false, hasButtons=true, typeDropdown= "rooms", subtitle=false, values= [2, 2, 0]})
  -
    const className = ["dropdown", "js-dropdown"]

  if isOpen
    - className.push("dropdown_opened")

  -  
    const elements = {
      rooms: ["спальни", "кровати", "ванные комнаты"],
      people: ["взрослые", "дети", "младенцы"],
    }

  div(class= className data-type= typeDropdown)
    label.dropdown__header(for='dropdownId')= title
      if(subtitle)
        span.dropdown__subtitle= subtitle
    .dropdown__menu
      button.dropdown__btn.js-dropdown__btn(id='dropdownId')
        span.dropdown__title #{buttonText}
        +chevron({})
      .dropdown__body
        ul.js-dropdown__list.dropdown__list
        if(hasButtons)
          .dropdown__buttons
            .dropdown__clear.js-dropdown__clear
              +button({className: "dropdown__clear-btn js-dropdown__clear-btn", text: "очистить", style: "text"})
            .dropdown__apply
              +button({text: "применить", style: "text"})
