mixin radioButtons({radios, name= "Name", title=false})
  .radio
    if title
      h3.radio__title= title
    .radio__container
      if radios.length
        each radio in radios
          label.radio__btn
            input.radio__input(type="radio" name= name checked= radio.isChecked)
            span.radio__span= radio.text
      else
        label.radio__btn
          input.radio__input(type="radio" name= name checked= true)
          span.radio__span= "Добавьте элементы"
