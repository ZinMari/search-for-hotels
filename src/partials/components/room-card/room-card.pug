include ../number-and-cost/number-and-cost
include ../rate-button/rate-button
include ../chevron/chevron


mixin room-card({info, starValue, reviews= 0, images=[]})
  .room-card
    .room-card__slider
      .glide.js-glide
        .glide__track(data-glide-el="track")
          ul.glide__slides
            if images.length
              each img in images
                li.glide__slide
                  img(src= img, alt="Изображение номера отеля")
            else
              li.glide__slide= "Добавьте изображения"
        .glide__arrows(data-glide-el="controls")
          button.glide__button.glide__button_direction_left(data-glide-dir="<")
            +chevron({className: "glide__arrow", direction: "left", color:"white"})
            
          button.glide__button.glide__button_direction_right(data-glide-dir=">")
           +chevron({className: "glide__arrow", direction: "left", color:"white"})

        .glide__bullets(data-glide-el="controls[nav]")
          - let index = 0;
          while index < images.length
            button.glide__bullet(data-glide-dir=`=${index++}`)

    .room-card__info
      .room-card__number-and-cost
        +number-and-cost(info)
      .room-card__rating
        .room-card__stars
          +rate-button(starValue)
        .room-card__reviews
          span.room-card__reviews-count= reviews
          | Отзывов
