include ../checkbox/checkbox.pug

mixin rich-checkbox-list(title, elems= [])
  .rich-checkbox-list
    h3.rich-checkbox-list__title= title
    ul.rich-checkbox-list__list
      if elems.length
        each elem in elems
          li.rich-checkbox-list__item
            +checkbox(elem.title || "Пустой список", elem.isChecked)
            p.rich-checkbox-list__description!= elem.description || "Пустое описание"
      else
        li.rich-checkbox-list__item
            +checkbox("Пустой список", true)
            p.rich-checkbox-list__description!= "Пустое описание"


