include ../checkbox/checkbox

mixin checkbox-list(title= '', list= [])
  .checkbox-list
    if title
      h3.checkbox-list__title= title
    ul.checkbox-list__wrap
      if list.length
        each elem in list
          li.checkbox-list__item
            +checkbox({text: elem.text || "Список пуст", isChecked: elem.isChecked})
      else
        +checkbox({text: "Список пуст", isChecked: true})