mixin button({text= 'Text', style= 'border', isDisabled= false, className=""})
  -
    const styles = {
      fill: "fill",
      border: "border",
      text: "text",
      arrow: "arrow",
    }

  -
    const classes = [
      `btn`,
      `btn_style_${styles[style]}`,
      className
    ]

  if isDisabled
    - classes.push('btn_disabled')

  button(class= [...classes])= text
