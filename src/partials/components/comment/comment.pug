include ../like-button/like-button

mixin comment({imgPath, name= "Имя Фамилия", date= "Дата", countLike, isLike, text="Текст комментария"})
  article.comment
    .comment__img-wrap
      if imgPath
        img.comment__img(src= imgPath, alt="Фото комментатора")
      else
        p= "IMAGE"
    .comment__title
      p.comment__name= name
      p.comment__time= date
    .comment__like
      +like-button({countLike: countLike, isLike: isLike})
    p.comment__text= text
