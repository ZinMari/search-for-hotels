include ../typography/typography

mixin toggle(elements=[], title= false)
  .toggle
    if title
      //- h3.toggle__title= title
      +typography({className: 'toggle__title', variant: 'h3', text: title, style: 'title', inlineBlock: true})
    ul.toggle__container
      if elements.length
        each elem in elements
          li.toggle__item
            label.toggle__label
              input.toggle__input(type="checkbox", checked= elem.isChecked)
              span.toggle__display
              |#{elem.description || "Вставьте текст"}
      else
        li Элементы не заданы