mixin icon-text-list(iconArr= [])
  ul.icon-text-list
    if iconArr.length
      each elem in iconArr
        li.icon-text-list__item
          .icon-text-list__img
            if(elem.src_icon)
              img(src= elem.src_icon , alt= elem.title)
            else
              p= "image"
          .icon-text-list__text
            h4.icon-text-list__title= elem.title || "Заголовок"
            p.icon-text-list__description= elem.description || "Описание"
    else
      li.icon-text-list__item= "Список пуст"
