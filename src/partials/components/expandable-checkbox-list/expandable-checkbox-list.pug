include ../checkbox-list/checkbox-list
include ../chevron/chevron

mixin expandable-checkbox-list(title= "Заголовок", checkboxList, isOpen= false)
  - let className = ["expandable-checkbox-list", "js-expandable-checkbox-list"];

  if(isOpen)
    - className.push("expandable-checkbox-list_opened");

  div(class= [...className])
    button.expandable-checkbox-list__btn.js-expandable-checkbox-list__btn= title
      +chevron({isOpen: isOpen})
    div.expandable-checkbox-list__list
      +checkbox-list('', checkboxList)
